# Nova Checkout Environment Variables
# Copy this file to .env and fill in your values

# Stripe API Keys
AU_STRIPE_SECRET_KEY=sk_test_your_au_secret_key_here
NZ_STRIPE_SECRET_KEY=sk_test_your_nz_secret_key_here

# Stripe Webhook Secrets
AU_STRIPE_WEBHOOK_SECRET=whsec_your_au_webhook_secret_here
NZ_STRIPE_WEBHOOK_SECRET=whsec_your_nz_webhook_secret_here

# WordPress Debug (optional)
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

