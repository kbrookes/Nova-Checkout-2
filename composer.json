{
    "name": "nova/checkout-v2",
    "description": "WordPress plugin for Stripe Checkout subscriptions with per-seat pricing and AU/NZ account routing",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "stripe/stripe-php": "^13.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/extension-installer": "^1.3",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "sebastian/phpcpd": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "NovaCheckout\\": "includes/"
        },
        "files": [
            "includes/helpers.php"
        ]
    },
    "scripts": {
        "lint": "find . -name '*.php' ! -path './vendor/*' -exec php -l {} \\;",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcpd": "phpcpd --exclude=vendor .",
        "audit": "composer audit",
        "test": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@phpcpd"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

